{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Watchlist": {
    "DataDir": "App_Data",
    "DailyMessageLimit": 200,
    "TimeZone": "Europe/London"
  }
}
