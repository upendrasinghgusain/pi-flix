# Copy to /opt/watchlist/.env on the Pi (chmod 600). Never commit the real one.

# TMDb: themoviedb.org -> Settings -> API -> "API Read Access Token"
Tmdb__ReadToken=

# OpenAI: platform.openai.com -> API keys. Set a monthly spending limit on the account.
OpenAI__ApiKey=
OpenAI__ChatModel=
OpenAI__TranscribeModel=

# Cloudflare Access: Zero Trust -> Access -> Applications -> this app
Access__TeamDomain=
Access__Audience=
Access__AllowedEmail=

# Radarr, which downloads every film on the list. pi/arr/setup.py fills these in on the Pi
# (the API key from Radarr's config.xml, and a new webhook secret) and sets up Radarr's webhook.
Radarr__Url=http://radarr:7878
Radarr__ApiKey=
Radarr__WebhookSecret=
# Optional: Radarr__QualityProfile (default "Watchlist", made by setup.py)

# Prowlarr and Sonarr, read by the Status tab. setup.py fills these in too.
Prowlarr__Url=http://prowlarr:9696
Prowlarr__ApiKey=
Sonarr__Url=http://sonarr:8989
Sonarr__ApiKey=

# Web Push: the app's own address, sent to push services as the sender. The signing keys are
# made on first start and kept in data/watchlist.db.
Push__Subject=https://
